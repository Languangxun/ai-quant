# 复制到 ~/.config/ai-quant/foreign_search.env 并 chmod 600
# 不要把真实 Clash 订阅、节点口令或 API Key 写进仓库。

# Pi 上 Clash/mihomo 的 mixed-port
FOREIGN_SEARCH_PROXY=http://127.0.0.1:7890

# 引擎顺序：google-news,bing,duckduckgo,google（Google News RSS 最稳）
FOREIGN_SEARCH_ENGINES=google-news,bing,duckduckgo

# 单条查询超时（秒）与返回条数
FOREIGN_SEARCH_TIMEOUT=10
FOREIGN_SEARCH_COUNT=8

# 可选：X 官方 API v2 Bearer Token（没有则用 site:x.com 网页检索兜底）
# X_BEARER_TOKEN=
